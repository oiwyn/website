<div id="vtbot-loading-indicator">
  <img src="/bg_logo.svg" alt="Loading" />
</div>

<style is:global>
  #vtbot-loading-indicator {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 24rem;
    height: auto;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
  }

  #vtbot-loading-indicator::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(246, 245, 241, 1) 5%,
        rgba(246, 245, 241, 0) 100%
  )
  }

  #vtbot-loading-indicator img {
    width: 100%;
    height: auto;
  }

  html.loading #vtbot-loading-indicator {
    animation: vtbot-blink 1s infinite;
  }

  @keyframes vtbot-blink {
    0%, 30%  { opacity: 0; }
    40%      { opacity: 0.5; }
    50%, 60% { opacity: 0; }
    80%      { opacity: 0.3; }
  }

  @media (max-width: 768px) {
    #vtbot-loading-indicator {
      display: none;
    }
  }
</style>
