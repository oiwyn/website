---
import BaseLayout from '../../layouts/BaseLayout.astro';
import back from '../../assets/web_back.svg?raw';

export async function getStaticPaths() {
  const projects = Object.values(
    await import.meta.glob('/src/content/projects/*/*.md', { eager: true })
  );
  return projects.map((project: any) => {
    const slug = project.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;

const slug = project.file.split('/').pop().replace('.md', '');
const images = import.meta.glob('/src/content/projects/*/*.{png,jpg,jpeg,webp,webm}', { eager: true });

const headerFile = project.frontmatter.header?.replace('./', '');
const headerPath = headerFile ? `/src/content/projects/${slug}/${headerFile}` : null;
const header: any = headerPath ? images[headerPath] : null;

const iconFile = project.frontmatter.icon?.replace('./', '');
const iconPath = iconFile ? `/src/content/projects/${slug}/${iconFile}` : null;
const icon: any = iconPath ? images[iconPath] : null;

const linkLabels: Record<string, string> = {
  'web': '🌐 Visit Website',
  'snapshot': '🗃️ Visit Snapshot',
  'figma': '👀 See Prototype',
  'appstore': '🛠️ Download on App Store',
  'playstore': '▶️ Download on Play Store',
};

---
<BaseLayout title={project.frontmatter.title} section={project.frontmatter.title}>
    <section class="project-page">
        <section class="project-detail">
            <div class="project-title">
                <a href="/" class="back">
                    <Fragment set:html={back} />
                </a>
                {icon && <img src={icon.default.src} alt={project.frontmatter.title} />}
                <h3>{project.frontmatter.title}</h3>
            </div>
            {header && <img src={header.default.src} alt={project.frontmatter.title} class="header" />}
            <div class="project-content">
                <div class="project-prop">
                    <div class="disc">
                        <h3>Discipline</h3>
                        <ul>
                            {project.frontmatter.discipline.map((disc: string) => (
                                <li>{disc}</li>
                            ))}
                        </ul>
                    </div>
                    <div class="for">
                        <h3>For</h3>
                        <ul>
                            {project.frontmatter.for.map((fr: string) => (
                                <li>{fr} ({project.frontmatter.year})</li>
                            ))}
                        </ul>
                    </div>
                   {project.frontmatter.links && project.frontmatter.links.length > 0 && (
                    <div class="links" id="inaction">
                        <h3>See it in action</h3>
                        <ul>
                        {project.frontmatter.links.map((link: any) => (
                            <a href={link.url} target="_blank" rel="noopener noreferrer">
                            <li>{linkLabels[link.type] || 'View Project'}</li>
                            </a>
                        ))}
                        </ul>
                    </div>
                    )}
                </div>
                <section>
                    <project.default />
                </section>
            </div>
        </section>
        <section class="footnote">
            <p>{project.frontmatter.nda ? "Sorry, I can't share much :-(" : "Thank you for reading! :-)"}</p>
            <a href="#" class="backtotop">↑ Go back to Top</a>
        </section>
    </section>
</BaseLayout>

<style is:global lang="scss">
    section{
        max-width: 62rem;
        letter-spacing: -0.03rem;
        &.project-page{
            background-color: white;
            margin: 4rem 0.7rem 4rem 0rem;
            padding: .75rem;
            border-radius: .75rem;
            border: 1px solid rgba(0,0,0,.15);
            box-shadow:
                inset 0 0 0 1px rgba(255, 255, 255, 0.05),
                0 1px 3px rgba(0, 0, 0, 0.05);
            font-family: 'Fraunces', serif;
            font-size: 1.25rem;
            font-weight: 200;
            letter-spacing: -0.03em;
            color: #838383;
            img{
                max-width: 62rem;
                border-radius: .5rem;
                @media (max-width: 768px) {
                    max-width: 100%;
                }
            }
            @media (max-width: 768px) {
                width: calc(100% - .1rem);
                margin: 4rem auto 0 auto;
            }
            .project-detail{
                display: flex;
                flex-direction: column;
                gap: .75rem;
                .header{
                    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
                    outline: 1px solid #eee;
                    outline-offset: -1px;
                }
                .project-title{
                    display: flex;
                    align-items: center;
                    padding-bottom: .75rem;
                    border-bottom: 1px solid #ccc;
                    gap: .5rem;
                    .back{
                        padding: .1rem .5rem;
                        border: 1px solid #e3e3e3;
                        border-radius: .5rem;
                        transition: all 0.15s ease;
                        svg{
                            fill: #bbb ;
                        }
                        &:hover{
                            background-color: #eee;
                            box-shadow: 0 2px 0 #ddd;
                            svg{
                                fill: #999;
                            }
                        }
                        &:active{
                            background-color: #e3e3e3;
                        }
                    }
                    img{
                        width: 2rem;
                        height: 2rem;
                        filter: drop-shadow(0px 2px 5px rgba(0, 0, 0, 0.15));
                        border-radius: 9px;
                        flex-grow: 0;
                        pointer-events: none;
                    }
                    h3{
                        font-family: 'Fraunces', 'Noto Serif JP', serif; 
                        font-weight: 300;
                        font-size: 1.6rem;
                        color: #333;
                    }
                }
                .project-content{
                    font-family: 'Inter', serif;
                    color: #111;
                    display: flex;
                    flex-direction: column;
                    gap: .75rem;
                    .project-prop{
                        display: flex;
                        flex-wrap: wrap;
                        justify-content: space-between;
                        gap: 1rem;
                        border: 1px solid #eee;
                        border-radius: .5rem;
                        padding: .3rem .6rem;
                        position: relative;
                        overflow: hidden;
                        background-color: #f9f9f9;
                        box-shadow: 0 1px 0 #ddd;
                        &::after {
                            content: '';
                            position: absolute;
                            inset: 0;
                            background-image:
                            linear-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px),
                            linear-gradient(90deg, rgba(0, 0, 0, 0.08) 1px, transparent 1px);
                            background-size: .75rem .75rem;
                            mask-image: radial-gradient(ellipse at bottom right, black 10%, transparent 30%);
                            -webkit-mask-image: radial-gradient(ellipse at bottom right, black 10%, transparent 30%);
                            pointer-events: none;
                        }
                        div{
                            flex-grow: 1;
                        }
                        h3{
                            font-weight: 500;
                            font-size: .75rem;
                            text-transform: uppercase;
                            padding-bottom: .25rem;
                            border-bottom: 1px solid #ddd;
                        }
                        .disc{
                            ul{
                                li{
                                    &:before{
                                        content:"· ";
                                        font-size: .75rem;
                                        line-height: 1rem;
                                    }
                                }
                            }
                        }
                        .links{
                            ul{
                                a{
                                    color: #353535;
                                    text-decoration: none;
                                    &:hover{
                                        text-decoration: underline;
                                    }
                                    &:active{
                                        color: black;
                                    }
                                }   
                            }
                        }
                        ul{
                            margin: .25rem 0rem;
                            li{
                                font-family: 'IBM Plex Mono', monospace;
                                font-size: .8rem;
                                font-weight: 300;
                                color: #353535;
                                padding: .05rem 0rem;
                                list-style: none;
                            }
                        }
                    }
                    section{
                        border: 1px solid #ddd;
                        border-radius: .5rem;
                        padding: 0.3rem 0.6rem 0.6rem 0.6rem;
                        margin-bottom: .05rem;
                        h1{
                            font-family: 'Fraunces', serif;
                            font-weight: 300;
                            font-size: 2.5rem;
                            border-bottom: 1px solid #ddd;
                            margin-bottom: .6rem;
                            color: #323232;
                            letter-spacing: -0.03em;
                        }
                        h2{
                            font-weight: 300;
                            font-size: .9rem;
                            padding-bottom: .35rem;
                            margin-bottom: .15rem;
                            border-bottom: 1px solid #ccc;
                            border-bottom-style: dotted;
                            color: #777;
                            letter-spacing: -0.03em;
                        }
                        h3{
                            font-size: .75rem;
                            font-weight: 300;
                            text-align: center;
                            text-transform: uppercase;
                            padding: .3rem;
                            border-top: 1px solid #ddd;
                            border-bottom: 1px solid #ddd;
                            background-color: #f6f6f6;
                            color: #777;
                            margin: .5rem -.6rem;
                        }
                        ul, ol{
                            padding: 0rem 0rem .15rem .5rem;
                            font-size: .9rem;
                            font-weight: 300;
                            letter-spacing: normal;
                            text-wrap: pretty;
                            text-rendering: optimizeLegibility;
                            list-style: none;
                            li{
                                &:before{
                                    content: "- ";
                                    display: inline-block;
                                    padding-right: .25rem;
                                    color: #ccc;
                                }
                            }
                        }
                        ol{
                            li{
                                &:before{
                                    content: "· ";
                                    display: inline-block;
                                    padding-right: .25rem;
                                    color: #ccc;
                                }
                            }
                        }
                        p{
                            padding: .25rem .1rem;
                            font-size: .9rem;
                            font-weight: 300;
                            letter-spacing: normal;
                            text-wrap: pretty;
                            text-rendering: optimizeLegibility;
                            a{
                                color: #555;
                            }
                        }
                        img{
                            max-width: 100%;
                            height: auto;
                            border-radius: .5rem;
                            outline: 1px solid #e5e5e5;
                            outline-offset: -1px;
                            background-color: #fff;
                            margin: 1rem 0rem;
                            @media (max-width: 768px) {
                                max-width: 100%;
                            }
                        }
                        em{
                            font-size: .7rem;
                            margin-top: -.6rem;
                            display: flex;
                            justify-content: center;
                        }
                        hr{
                            border: none;
                            height: 1px;
                            background:
                                linear-gradient(180deg, rgba(0, 0, 0, 0) 80%, rgba(0, 0, 0, 0.04) 100%), #FFFFFF;
                            box-shadow:
                                0 3px 0 0 #ddd,
                                0 6px 0 0 #ddd,
                                0 9px 0 0 #ddd;
                            margin: .75rem 0rem 1rem 0rem;
                        }
                        iframe{
                            border-radius: .5rem;
                            border: 1px solid #ccc;
                            margin-bottom: -0.25rem;
                        }
                    }
                }
            }
            .footnote{
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                padding: .5rem 0rem 0rem 0rem;
                p{
                    font-size: 1.3rem;
                    font-weight: 300;
                    color: #d5d5d5;
                    padding-left: .25rem;
                    @media (max-width: 768px) {
                        font-size: 1rem;
                    }
                }
                .backtotop{
                    color: GREY;
                    text-decoration: none;
                    text-transform: uppercase;
                    font-family: 'Inter', sans-serif;
                    font-size: .75rem;
                    font-weight: 300;
                    width: fit-content;
                    padding: .5rem;
                    border: 1px solid #e3e3e3;
                    border-radius: .5rem;
                    transition: all 0.15s ease;
                    @media (max-width: 768px) {
                        font-size: .7rem;
                    }
                    &:hover{
                        background-color: #eee;
                        box-shadow: 0 1px 0 #ddd;
                        color: #999;
                    }
                    &:active{
                        background-color: #e3e3e3;
                    }
                }
            }
        }
    }
</style>
                        